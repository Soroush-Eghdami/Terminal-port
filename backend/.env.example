# Copy to backend/.env (never commit .env — it's gitignored)
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# GitHub sync — token raises rate limit from 60/hr to 5,000/hr
# Create at https://github.com/settings/tokens (no scopes needed, public data)
GITHUB_USERNAME=Soroush-Eghdami
GITHUB_TOKEN=

# Contact form email notifications (Gmail SMTP + app password)
# Fill these in — without them, contact messages are only saved to the DB
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CONTACT_RECIPIENT_EMAIL=
